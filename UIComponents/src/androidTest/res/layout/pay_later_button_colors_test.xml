<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.braintreepayments.api.uicomponents.PayLaterButton
        android:id="@+id/pay_later_blue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:paymentButtonColor="blue" />

    <com.braintreepayments.api.uicomponents.PayLaterButton
        android:id="@+id/pay_later_black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:paymentButtonColor="black" />

    <com.braintreepayments.api.uicomponents.PayLaterButton
        android:id="@+id/pay_later_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:paymentButtonColor="white" />
</LinearLayout>
